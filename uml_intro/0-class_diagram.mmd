classDiagram
    Library "1"o--"0.." Book
    Library "1"o--"0.." User
    Library "1"*--"0.." Loan
    Loan "0.."-->"1" User
    Book "1"<--"0.." Loan
    Library : -list books
    Library : -list users
    Library: -list loans
    Library: +add_book()
    Library: +register_user()
    Library: +create_loan()
    class Book {
        -str title
        -str author
        -bool state
        +mark_as_unavailable()
        +mark_as_available()
    }
    class User {
        -str name
        -str email
    }
    class Loan {
        -date start_date
        -date end_date
        
        +close_loan()
    }